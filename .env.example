# Copy this file to .env.local and fill in real values for your deployment.
# NOTE: Because this is a pure frontend (Vite) app, anything in VITE_* env
# vars gets baked into the JS bundle shipped to the browser — it is NOT a
# secret. Changing these away from the defaults only stops the password
# from being the literal word "admin123" in the repo; it does not make
# /admin secure. Real protection requires a backend that verifies
# credentials server-side and issues a session token.
VITE_ADMIN_USERNAME=admin
VITE_ADMIN_PASSWORD=change-me-before-deploying
